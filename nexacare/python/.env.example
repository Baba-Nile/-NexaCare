# Copy to .env, fill in, and load into the environment of the server process. NEVER commit the real file.
PORTAL_ENABLED=1
PORTAL_ENV=production
# PostgreSQL connection string (use a dedicated low-privilege database user; require TLS)
DATABASE_URL=postgresql://nexacare_app:CHANGE_ME@db.internal:5432/nexacare?sslmode=require
# Flask signing key for the short-lived pre-login cookie: python python/manage.py gen-keys
PORTAL_SECRET_KEY=
# Field-encryption key(s) for clinical text, comma-separated, newest first (rotation: add a new key in front, keep old ones until re-encrypted)
PORTAL_DATA_KEY=
# Salt used to hash client addresses for login throttling
PORTAL_HASH_SALT=
# Separate key that encrypts database backups (store it apart from the backups)
PORTAL_BACKUP_KEY=
# Number of reverse proxies in front of the app whose X-Forwarded-For header is trusted (0 = none)
NEXACARE_TRUSTED_PROXIES=1
NEXACARE_ALLOWED_ORIGINS=https://www.example.co.ke
NEXACARE_HASH_SALT=
